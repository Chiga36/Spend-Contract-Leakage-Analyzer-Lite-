# Copy to .env and adjust. Real environment variables take precedence over this file.
HOST=127.0.0.1
PORT=8000
ERP_DB_PATH=data/erp.db
CONTRACTS_DIR=data/contracts
OUTPUT_DIR=output
LLM_MODE=off                 # off | gemini | openai | claude
LLM_MODEL=                   # blank = default for the mode (gemini: gemini-3.5-flash, openai: gpt-5, claude: claude-opus-5-5)
GEMINI_API_KEY=              # only when LLM_MODE=gemini (free key: https://aistudio.google.com/apikey)
OPENAI_API_KEY=              # only when LLM_MODE=openai
ANTHROPIC_API_KEY=           # only when LLM_MODE=claude
HTTPS_PROXY=                 # if the company requires a proxy
PRICE_TOLERANCE_PCT=2
GROUND_TRUTH_PATH=data/planted_anomalies.json   # planted anomalies; enables the evaluation metrics
UPLOADS_DIR=data/uploads                       # datasets uploaded from the Start page
LLM_MAX_CALLS_PER_RUN=100           # guardrail: LLM calls per run
LLM_MAX_CHARS_PER_RUN=1500000       # guardrail: characters sent per run
